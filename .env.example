# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/gsb_export?schema=public"

# Application Configuration
NEXT_PUBLIC_SITE_URL="https://gsbexport.com"
NEXT_PUBLIC_COMPANY_NAME="GSB Export"

# Business Notification & Customer Support Emails
BUSINESS_NOTIFICATION_EMAIL="enquiry@gsbexport.com"
CUSTOMER_SUPPORT_EMAIL="info@gsbexport.com"

# Email Provider Configuration (Resend or SMTP)
EMAIL_PROVIDER="smtp" # or "resend"

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_placeholder_key"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="GSB Export <noreply@gsbexport.com>"
SMTP_SECURE="false"

# Private S3-Compatible Object Storage (Technical Document Uploads)
STORAGE_PROVIDER="s3" # "s3", "r2", or "local"
S3_REGION="auto"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET_NAME="gsb-export-enquiry-attachments"
S3_ACCESS_KEY_ID="placeholder_access_key"
S3_SECRET_ACCESS_KEY="placeholder_secret_key"

